<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 界面唯一取色处：只保留语义名，改一处即全站生效 -->

    <!-- 双端品牌色 -->
    <color name="brand_doctor_primary">#FF2563EB</color> <!-- 医生端主色 -->
    <color name="brand_doctor_primary_dark">#FF1D4ED8</color> <!-- 医生端主色深 -->
    <color name="brand_patient_primary">#FF16A34A</color> <!-- 患者端主色 -->
    <color name="brand_patient_primary_light">#FF22C55E</color> <!-- 患者端辅绿 -->

    <!-- 表面与文字 -->
    <color name="surface">#FFFFFFFF</color> <!-- 卡片与页面底色 -->
    <color name="surface_variant">#FFF9FAFB</color> <!-- 次级表面、浅色底块 -->
    <color name="on_surface">#FF1F2937</color> <!-- 主要文字 -->
    <color name="on_surface_secondary">#FF4B5563</color> <!-- 次要文字 -->
    <color name="on_surface_tertiary">#FF9CA3AF</color> <!-- 提示文字与占位 -->
    <color name="outline">#FFD1D5DB</color> <!-- 描边 -->
    <color name="divider">#FFE5E7EB</color> <!-- 分隔线 -->

    <!-- 通用主色与反色文字 -->
    <color name="primary">#FF2563EB</color> <!-- 主操作色 -->
    <color name="on_primary">#FFFFFFFF</color> <!-- 主色上的文字与图标 -->

    <!-- 语义反馈色 -->
    <color name="success">#FF16A34A</color> <!-- 成功、已完成 -->
    <color name="warning">#FFEA580C</color> <!-- 警示、待处理 -->
    <color name="danger">#FFDC2626</color> <!-- 错误、驳回 -->
    <color name="info">#FF3B82F6</color> <!-- 信息提示 -->

    <!-- 禁用与遮罩 -->
    <color name="disabled_bg">#FFE5E7EB</color> <!-- 禁用态底色 -->
    <color name="disabled_fg">#FF9CA3AF</color> <!-- 禁用态前景 -->
    <color name="scrim">#33000000</color> <!-- 半透明遮罩与阴影 -->

    <!-- 任务与计划状态 -->
    <color name="status_pending">#FF2563EB</color> <!-- 待执行 -->
    <color name="status_completed">#FF16A34A</color> <!-- 已完成 -->
    <color name="status_skipped_rejected">#FF6B7280</color> <!-- 已跳过、已驳回 -->
    <color name="status_review">#FFEA580C</color> <!-- 待审核 -->

</resources>
