<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 界面唯一取字号处：全站 6 档文本外观，布局里只引用不写字号 -->

    <!-- 6 档文本外观的公共父级，parent 置空以切断隐式继承 -->
    <style name="TextAppearance.WinsRehab" parent="" />

    <style name="TextAppearance.WinsRehab.Caption11">
        <item name="android:textSize">11sp</item> <!-- 说明文字、角标 -->
    </style>

    <style name="TextAppearance.WinsRehab.Body12">
        <item name="android:textSize">12sp</item> <!-- 辅助信息、时间戳 -->
    </style>

    <style name="TextAppearance.WinsRehab.Body14">
        <item name="android:textSize">14sp</item> <!-- 正文 -->
    </style>

    <style name="TextAppearance.WinsRehab.Title16">
        <item name="android:textSize">16sp</item> <!-- 小标题、列表主文字 -->
    </style>

    <style name="TextAppearance.WinsRehab.Headline20">
        <item name="android:textSize">20sp</item> <!-- 页面标题 -->
    </style>

    <style name="TextAppearance.WinsRehab.Display24">
        <item name="android:textSize">24sp</item> <!-- 数值强调 -->
    </style>

    <!-- ========== 第 3 组：按钮 ========== -->
    <!-- 四种语义（主/次/危险/文字）× 两档尺寸（标准 48dp / 小档 36dp），禁用态交给 selector 切 disabled_bg/disabled_fg -->

    <!-- 按钮基座：字号、去全大写、圆角、最小高度与左右内距；语义样式只覆盖配色 -->
    <style name="Widget.WinsRehab.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAppearance">@style/TextAppearance.WinsRehab.Title16</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="cornerRadius">@dimen/radius_16</item>
    </style>

    <!-- 主按钮：底色跟随主题（医生蓝 / 患者深绿），白字 -->
    <style name="Widget.WinsRehab.Button.Primary">
        <item name="android:backgroundTint">?attr/winsButtonPrimaryTint</item>
        <item name="android:textColor">@color/btn_primary_text</item>
    </style>

    <!-- 次按钮：白底 + 品牌主色描边 + 主色文字 -->
    <style name="Widget.WinsRehab.Button.Secondary">
        <item name="android:backgroundTint">@color/btn_secondary_bg</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
        <item name="strokeColor">@color/btn_secondary_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 危险按钮：danger 实底（白字 4.83:1），只用于删除/驳回这类不可逆动作 -->
    <style name="Widget.WinsRehab.Button.Danger">
        <item name="android:backgroundTint">@color/btn_danger_bg</item>
        <item name="android:textColor">@color/btn_danger_text</item>
    </style>

    <!-- 文字按钮：不铺底，只换文字色；用于同级动作里的「取消 / 稍后」 -->
    <style name="Widget.WinsRehab.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.WinsRehab.Title16</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="android:textColor">@color/btn_text_fg</item>
    </style>

    <!-- 小档尺寸：列表行内动作按钮用 12sp 字号 + 36dp 高 + radius_8 -->
    <style name="Widget.WinsRehab.Button.Primary.Small">
        <item name="android:textAppearance">@style/TextAppearance.WinsRehab.Body12</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">@dimen/space_12</item>
        <item name="android:paddingEnd">@dimen/space_12</item>
        <item name="cornerRadius">@dimen/radius_8</item>
    </style>

    <style name="Widget.WinsRehab.Button.Secondary.Small">
        <item name="android:textAppearance">@style/TextAppearance.WinsRehab.Body12</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">@dimen/space_12</item>
        <item name="android:paddingEnd">@dimen/space_12</item>
        <item name="cornerRadius">@dimen/radius_8</item>
    </style>

    <style name="Widget.WinsRehab.Button.Danger.Small">
        <item name="android:textAppearance">@style/TextAppearance.WinsRehab.Body12</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">@dimen/space_12</item>
        <item name="android:paddingEnd">@dimen/space_12</item>
        <item name="cornerRadius">@dimen/radius_8</item>
    </style>

    <style name="Widget.WinsRehab.Button.Text.Small">
        <item name="android:textAppearance">@style/TextAppearance.WinsRehab.Body12</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">@dimen/space_12</item>
        <item name="android:paddingEnd">@dimen/space_12</item>
    </style>

    <!-- ========== 第 3 组：输入框 ========== -->
    <!-- 标签/必填标记/错误文案/辅助文案四部分由 layout/widget_text_field.xml 承载，这里只管描边、圆角与状态色 -->
    <style name="Widget.WinsRehab.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/input_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_8</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_8</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_8</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_8</item>
        <item name="hintTextAppearance">@style/TextAppearance.WinsRehab.Body12</item>
        <item name="errorTextAppearance">@style/TextAppearance.WinsRehab.Body12</item>
        <item name="helperTextEnabled">true</item>
        <item name="errorEnabled">true</item>
    </style>

    <!-- ========== 第 3 组：卡片 ========== -->
    <!-- 标准卡片：白底 + radius_12 + elevation_1，全站卡片的统一底子 -->
    <style name="Widget.WinsRehab.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_12</item>
        <item name="cardElevation">@dimen/elevation_1</item>
    </style>

    <!-- 可点击卡片：在标准卡片上加点击态与无障碍焦点 -->
    <style name="Widget.WinsRehab.Card.Clickable">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- 带状态条卡片：靠顶部 4dp 语义色条区分状态，所以压平阴影；色条自带圆角贴合卡片 -->
    <style name="Widget.WinsRehab.Card.StatusBar">
        <item name="cardElevation">@dimen/elevation_0</item>
    </style>

    <!-- ========== 第 3 组：状态徽标 ========== -->
    <!-- 状态徽标：容器底 + 12sp 粗体文案，具体颜色由 StatusBadge 运行期按状态装配；parent 置空切断点号隐式继承 -->
    <style name="Widget.WinsRehab.StatusBadge" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:backgroundTint">@color/surface_variant</item>
        <item name="android:textColor">@color/on_surface_secondary</item>
        <item name="android:textAppearance">@style/TextAppearance.WinsRehab.Body12</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">@dimen/space_8</item>
        <item name="android:paddingEnd">@dimen/space_8</item>
        <item name="android:paddingTop">@dimen/space_4</item>
        <item name="android:paddingBottom">@dimen/space_4</item>
    </style>

    <!-- ========== 第 4 组：分区标题与信息行 ========== -->
    <!-- 分区标题：16sp 粗体 + on_surface；宽高随内容，使用方只写 style 与文字即可 -->
    <style name="Widget.WinsRehab.SectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.WinsRehab.Title16</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">@dimen/space_12</item>
    </style>

    <!-- ========== 第 4 组：对话框 ========== -->
    <!-- 对话框本体：surface 实底，底板形状由下面的 ShapeAppearance 统一成 radius_16 -->
    <style name="Widget.WinsRehab.Dialog" parent="MaterialAlertDialog.MaterialComponents">
        <item name="backgroundTint">@color/surface</item>
    </style>

    <!-- 对话框圆角：Material 对话框读 shapeAppearanceMediumComponent，覆盖成 radius_16 -->
    <style name="ShapeAppearance.WinsRehab.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">@dimen/radius_16</item>
    </style>

    <!-- 对话框标题：父样式负责宽度高度与省略号，字号仍走 Title16 档 -->
    <style name="Widget.WinsRehab.DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.WinsRehab.Title16</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- 对话框主题覆盖：MaterialAlertDialogBuilder 自动套用，圆角/标题/正文/按钮一处生效 -->
    <style name="ThemeOverlay.WinsRehab.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/Widget.WinsRehab.Dialog</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.WinsRehab.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.WinsRehab.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.WinsRehab.Body14</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.WinsRehab.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.WinsRehab.Button.Text</item>
    </style>

    <!-- 底部弹层圆角：四角统一 radius_16（下沿在屏幕外，视觉上只看到上沿） -->
    <style name="ShapeAppearance.WinsRehab.BottomSheet" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">@dimen/radius_16</item>
    </style>

    <!-- 底部弹层本体：surface 实底 + 统一圆角，去掉 Material 默认的角部叠加 -->
    <style name="Widget.WinsRehab.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.WinsRehab.BottomSheet</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

    <!-- 底部弹层主题覆盖：BottomSheetDialog(context, 本样式) 一处套用 -->
    <style name="ThemeOverlay.WinsRehab.BottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.WinsRehab.BottomSheet</item>
    </style>

    <!-- ========== 第 4 组：底部导航 ========== -->
    <!-- 双端底部导航共用结构：surface 底、1dp 阴影、24dp 图标、12sp 标签；选中色仍由各端 selector 提供 -->
    <style name="Widget.WinsRehab.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="android:elevation">@dimen/elevation_1</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.WinsRehab.Body12</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.WinsRehab.Body12</item>
        <item name="itemRippleColor">?attr/colorPrimary</item>
    </style>

</resources>
