<?xml version="1.0" encoding="utf-8"?>
<!-- 功能卡底：白到提醒浅底（黄）的自上而下渐变，1dp 同色描边 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:startColor="@color/surface"
        android:endColor="@color/notice_container"
        android:angle="270"/>
    <corners android:radius="@dimen/radius_16"/>
    <stroke android:width="1dp" android:color="@color/notice_container"/>
</shape>
