<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 背景颜色（卡片浅色底） -->
    <solid android:color="@color/surface_variant" />

    <!-- 圆角 -->
    <corners android:radius="@dimen/radius_12" />

    <!-- 阴影/边框（可选） -->
    <stroke
        android:width="1dp"
        android:color="@color/scrim" />

    <!-- 内边距（可选，避免内容紧贴边缘） -->
    <padding
        android:left="@dimen/space_8"
        android:top="@dimen/space_8"
        android:right="@dimen/space_8"
        android:bottom="@dimen/space_8" />
</shape>
