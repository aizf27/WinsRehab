<?xml version="1.0" encoding="utf-8"?>
<!-- 添加训练任务的BottomSheetDialog -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_rounded_white_card"
    android:padding="24dp">

    <!-- 标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="添加训练任务"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <!-- 任务名称 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="任务名称"
        android:textSize="14sp"
        android:textColor="#4B5563"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/et_task_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:hint="如：肩关节外展训练"
        android:textSize="14sp"
        android:textColor="#1F2937"
        android:textColorHint="#9CA3AF"/>

    <!-- 任务描述 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="任务描述"
        android:textSize="14sp"
        android:textColor="#4B5563"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/et_task_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:hint="详细描述训练动作和要求"
        android:textSize="14sp"
        android:textColor="#1F2937"
        android:textColorHint="#9CA3AF"
        android:minLines="3"
        android:gravity="top"/>

    <!-- 任务类型 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="任务类型"
        android:textSize="14sp"
        android:textColor="#4B5563"
        android:textStyle="bold"/>

    <Spinner
        android:id="@+id/spinner_task_type"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"/>

    <!-- 建议时长 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="建议时长（分钟）"
        android:textSize="14sp"
        android:textColor="#4B5563"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/et_task_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:hint="如：30"
        android:inputType="number"
        android:textSize="14sp"
        android:textColor="#1F2937"
        android:textColorHint="#9CA3AF"/>

    <!-- 执行频率 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="执行频率"
        android:textSize="14sp"
        android:textColor="#4B5563"
        android:textStyle="bold"/>

    <RadioGroup
        android:id="@+id/rg_frequency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_daily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="每天"
            android:textSize="14sp"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/rb_weekly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="每周特定天"
            android:textSize="14sp"/>

        <RadioButton
            android:id="@+id/rb_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="间隔天数"
            android:textSize="14sp"/>
    </RadioGroup>

    <!-- 频率详情容器 -->
    <LinearLayout
        android:id="@+id/layout_frequency_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 每周选择 -->
        <LinearLayout
            android:id="@+id/layout_weekly_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择星期几（可多选）"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_monday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="一"
                    android:textSize="12sp"/>

                <CheckBox
                    android:id="@+id/cb_tuesday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="二"
                    android:textSize="12sp"/>

                <CheckBox
                    android:id="@+id/cb_wednesday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="三"
                    android:textSize="12sp"/>

                <CheckBox
                    android:id="@+id/cb_thursday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="四"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_friday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="五"
                    android:textSize="12sp"/>

                <CheckBox
                    android:id="@+id/cb_saturday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="六"
                    android:textSize="12sp"/>

                <CheckBox
                    android:id="@+id/cb_sunday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="日"
                    android:textSize="12sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 间隔天数输入 -->
        <LinearLayout
            android:id="@+id/layout_interval_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每隔"
                android:textSize="14sp"
                android:textColor="#4B5563"/>

            <EditText
                android:id="@+id/et_interval_days"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_input_field"
                android:padding="8dp"
                android:hint="2"
                android:inputType="number"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="#1F2937"
                android:textColorHint="#9CA3AF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="天执行一次"
                android:textSize="14sp"
                android:textColor="#4B5563"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 优先级 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="优先级"
        android:textSize="14sp"
        android:textColor="#4B5563"
        android:textStyle="bold"/>

    <RadioGroup
        android:id="@+id/rg_priority"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_normal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="普通"
            android:textSize="14sp"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/rb_important"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="重要"
            android:textSize="14sp"/>
    </RadioGroup>

    <!-- 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="取消"
            android:textSize="16sp"
            android:textColor="#6B7280"
            android:background="@drawable/bg_button_secondary"/>

        <Button
            android:id="@+id/btn_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="确认添加"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_primary"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>

