<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 背景图片 -->
    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_ptlog"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 滚动内容 -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_24"
            android:gravity="center_horizontal">

            <!-- 顶部标题：患者登录 -->
            <TextView
                android:id="@+id/tvPtLoginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:text="患者登录" android:textAppearance="@style/TextAppearance.WinsRehab.Display24"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_marginTop="@dimen/space_32"/>


            <!-- 副标题 -->
            <TextView
                android:id="@+id/tvPtLoginSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:text="Grow towards the sun" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_marginTop="@dimen/space_8"/>

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:layout_marginTop="@dimen/space_24"
                android:layout_gravity="left">

                <!-- 图片 -->
                <ImageView
                    android:id="@+id/imgPtLoginBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/shape_round_image"
                    android:clipToOutline="true"
                    android:src="@drawable/img_tohealthy"/>
                <!-- 叠加文字 -->
                <TextView
                    android:id="@+id/tvBannerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center"
                    android:text="Be in good health"
                    android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                    android:textStyle="bold" />
            </FrameLayout>
            <!-- 输入框容器 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_32">

                <!-- 手机号输入 -->
                <!-- 密码输入 -->

                <EditText
                    android:id="@+id/etPtAccount"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@drawable/shape_edittext_bg"
                    android:drawableStart="@drawable/baseline_account_box_24"
                    android:drawablePadding="@dimen/space_12"
                    android:hint="手机号"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12" android:textAppearance="@style/TextAppearance.WinsRehab.Title16" />

                <EditText
                    android:id="@+id/etPtPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="密码"
                    android:drawableStart="@drawable/baseline_lock_24"
                    android:drawablePadding="@dimen/space_12"
                    android:background="@drawable/shape_edittext_bg"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:inputType="textPassword" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                    android:layout_marginTop="@dimen/space_16"/>

                <CheckBox
                    android:id="@+id/cbRememberPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="记住密码"
                    android:textColor="@color/on_surface"
                    android:theme="@style/MyCheckBox"
                    android:minHeight="@dimen/space_48"
                    android:minWidth="@dimen/space_48" />

            </LinearLayout>

            <!-- 登录按钮 -->

            <Button
                android:id="@+id/btnPtLogin"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/space_24"
                android:backgroundTint="@color/brand_patient_primary"
                style="@style/MyRoundButton"
                android:text="登录"
                android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Title16" />

            <Button
                android:id="@+id/btnPtRegister"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="注册"
                android:textColor="@color/on_surface" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                android:layout_marginTop="@dimen/space_16"
                android:backgroundTint="@color/outline"
                style="@style/MyRoundButton"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
