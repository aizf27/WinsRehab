<?xml version="1.0" encoding="utf-8"?>
<!-- 患者登录页：与医生登录页同构，主色换患者绿，横幅图上文案同样不放底板 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- 装饰底图：只做背景，不承载任何文字 -->
    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_ptlog"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_24">

            <TextView
                android:id="@+id/tvPtLoginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:text="@string/patient_login_title"
                android:textAppearance="@style/TextAppearance.WinsRehab.Display24"
                android:textColor="@color/on_surface"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPtLoginSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/patient_login_subtitle"
                android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                android:textColor="@color/on_surface_secondary" />

            <!-- 横幅图：图片圆角裁切，文字直接压在图上 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="@dimen/space_24">

                <ImageView
                    android:id="@+id/imgPtLoginBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shape_round_image"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_tohealthy" />

                <!-- 透明底图文案：深色粗体 + 浅色描边阴影，压在亮区暗区都能读 -->
                <TextView
                    android:id="@+id/tvBannerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/space_12"
                    android:background="@null"
                    android:shadowColor="@color/on_primary"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="3"
                    android:text="@string/patient_login_banner"
                    android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- 表单卡：输入项与按钮统一卡内排布 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WinsRehab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <com.example.winsrehab.ui.common.TextField
                        android:id="@+id/fieldAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <com.example.winsrehab.ui.common.TextField
                        android:id="@+id/fieldPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16" />

                    <CheckBox
                        android:id="@+id/cbRememberPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:minHeight="@dimen/space_48"
                        android:text="@string/action_remember_password"
                        android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                        android:textColor="@color/on_surface"
                        android:buttonTint="?attr/colorPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPtLogin"
                        style="@style/Widget.WinsRehab.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/action_login" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPtRegister"
                        style="@style/Widget.WinsRehab.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/action_register" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
