<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant"> <!-- 对应 bg-gray-50 -->

    <!-- 1. 顶部标题栏 (Header) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:elevation="@dimen/elevation_1"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:text="个人信息"
            android:textColor="@color/success" android:textAppearance="@style/TextAppearance.WinsRehab.Headline20"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btnEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_16"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/space_8"
            android:text="编辑"
            android:textColor="@color/success" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. 滚动内容区域 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- 个人资料卡片 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/profileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_24"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_16"
                app:cardElevation="@dimen/elevation_1">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pt_welcome_green"
                    android:padding="@dimen/space_24">

                    <!-- 头像区域 -->
                    <FrameLayout
                        android:id="@+id/avatarContainer"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_avatar_circle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_user"
                            app:tint="@color/brand_patient_primary"/>
                    </FrameLayout>

                    <!-- 文字信息 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/avatarContainer"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tvPatientName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/space_4"
                            android:text="未设置"
                            android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Headline20"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPatientGender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="性别 · 年龄"
                            android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" />

                        <TextView
                            android:id="@+id/tvPatientSignature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="个性签名"
                            android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- ================= 基本信息板块 ================= -->
            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:text="基本信息" />

            <androidx.cardview.widget.CardView
                style="@style/InfoCardStyle">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/item_info_row" android:id="@+id/row_phone" />
                    <View style="@style/Divider" />

                    <include layout="@layout/item_info_row" android:id="@+id/row_email" />
                    <View style="@style/Divider" />

                    <include layout="@layout/item_info_row" android:id="@+id/row_dob" />
                    <View style="@style/Divider" />

                    <include layout="@layout/item_info_row" android:id="@+id/row_address" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ================= 康复信息板块 ================= -->
            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:text="康复信息" />

            <androidx.cardview.widget.CardView
                style="@style/InfoCardStyle">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/item_info_row" android:id="@+id/row_doctor" />
                    <View style="@style/Divider" />
                    <include layout="@layout/item_info_row" android:id="@+id/row_record" />
                    <View style="@style/Divider" />

                    <include layout="@layout/item_info_row" android:id="@+id/row_training" />



                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ================= 设置板块 ================= -->
            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:text="设置" />

            <androidx.cardview.widget.CardView
                style="@style/InfoCardStyle">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/item_info_row" android:id="@+id/row_system" />
                    <View style="@style/Divider" />

                    <!-- 切换账户 (红色特殊样式) -->
                    <LinearLayout
                        android:id="@+id/btnLogout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/space_16"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true">

                        <!-- LogOut Icon -->
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_logout"
                            app:tint="@color/danger" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:text="切换账户"
                            android:textColor="@color/danger" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/on_surface_tertiary" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>