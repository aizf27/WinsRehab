<?xml version="1.0" encoding="utf-8"?><!-- 创建康复计划页：顶部栏 + 患者卡 + 计划信息表单 + 任务列表 + 底部操作条 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant">

    <!-- 顶部栏：返回 + 标题 -->
    <include
        android:id="@+id/topBar"
        layout="@layout/widget_top_bar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 可滚动表单区：底部让出操作条高度 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/formScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_16"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- 患者卡：只能从患者入口进入，所以这里只做展示 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WinsRehab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_avatar_circle">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_user"
                            app:tint="@color/brand_doctor_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_patient_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                            android:textColor="@color/on_surface"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_patient_diagnosis"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                            android:textColor="@color/on_surface_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 计划基本信息 -->
            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="计划基本信息" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WinsRehab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <!-- 计划名称 -->
                    <com.example.winsrehab.ui.common.TextField
                        android:id="@+id/fieldPlanName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- 康复目标 -->
                    <com.example.winsrehab.ui.common.TextField
                        android:id="@+id/fieldPlanGoal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12" />

                    <!-- 开始日期：点开系统日期选择器 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="开始日期"
                        android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                        android:textColor="@color/on_surface_secondary" />

                    <TextView
                        android:id="@+id/tv_start_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:background="@drawable/bg_input_field"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:drawablePadding="@dimen/space_8"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:paddingStart="@dimen/space_12"
                        android:paddingTop="@dimen/space_12"
                        android:paddingEnd="@dimen/space_12"
                        android:paddingBottom="@dimen/space_12"
                        android:text="选择开始日期"
                        android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                        android:textColor="@color/on_surface_secondary" />

                    <!-- 预计周期（天） -->
                    <com.example.winsrehab.ui.common.TextField
                        android:id="@+id/fieldPlanDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 训练任务：标题行带添加入口 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="训练任务"
                    android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_add_task"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/space_4"
                    android:text="+ 添加任务"
                    android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                    android:textColor="@color/warning"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:nestedScrollingEnabled="false" />

            <!-- 任务空态：还没有加任务时给引导文案 -->
            <LinearLayout
                android:id="@+id/empty_tasks_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_24"
                android:paddingBottom="@dimen/space_24">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:alpha="0.3"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_task"
                    app:tint="@color/on_surface_tertiary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="还没有添加训练任务"
                    android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                    android:textColor="@color/on_surface_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="点击右上角「添加任务」开始创建"
                    android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                    android:textColor="@color/on_surface_tertiary" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部操作条：统一错误位 + 草稿 / 启用两个按钮 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="@dimen/elevation_1"
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_form_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
            android:textColor="@color/danger"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_draft"
                style="@style/Widget.WinsRehab.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="保存草稿" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_activate_plan"
                style="@style/Widget.WinsRehab.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="启用计划" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
