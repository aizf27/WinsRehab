<?xml version="1.0" encoding="utf-8"?>
<!-- 创建康复计划页面 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant">

    <!-- 顶部标题栏 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_brand_gradient"
        android:elevation="@dimen/elevation_1"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:padding="@dimen/space_12"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/on_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="创建康复计划"
            android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Headline20"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 滚动内容区域 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_48"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- 患者信息卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="@dimen/elevation_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16"
                    android:gravity="center_vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="@dimen/radius_16"
                        app:cardElevation="@dimen/elevation_0"
                        app:cardBackgroundColor="@color/surface_variant">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_user"
                            app:tint="@color/warning"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_12"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_patient_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="患者姓名" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface"/>

                        <TextView
                            android:id="@+id/tv_patient_diagnosis"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="诊断信息" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                            android:textColor="@color/on_surface_secondary"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 计划基本信息 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="计划基本信息" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_marginBottom="@dimen/space_12"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="@dimen/elevation_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <!-- 计划名称 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="计划名称" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                        android:textColor="@color/on_surface_secondary"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/et_plan_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:background="@drawable/bg_input_field"
                        android:padding="@dimen/space_12"
                        android:hint="如：上肢功能康复计划" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/on_surface_tertiary"/>

                    <!-- 康复目标 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:text="康复目标" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                        android:textColor="@color/on_surface_secondary"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/et_plan_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:background="@drawable/bg_input_field"
                        android:padding="@dimen/space_12"
                        android:hint="如：恢复手臂抬举功能至90度" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/on_surface_tertiary"
                        android:minLines="2"
                        android:gravity="top"/>

                    <!-- 开始日期 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:text="开始日期" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                        android:textColor="@color/on_surface_secondary"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_start_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:background="@drawable/bg_input_field"
                        android:padding="@dimen/space_12"
                        android:text="选择开始日期" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                        android:textColor="@color/on_surface"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:drawableTint="@color/on_surface_tertiary"
                        android:clickable="true"
                        android:focusable="true"/>

                    <!-- 预计周期 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:text="预计周期（天）" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                        android:textColor="@color/on_surface_secondary"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/et_plan_duration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:background="@drawable/bg_input_field"
                        android:padding="@dimen/space_12"
                        android:hint="如：30"
                        android:inputType="number" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/on_surface_tertiary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 训练任务 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/space_12">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="训练任务" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"/>

                <TextView
                    android:id="@+id/btn_add_task"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ 添加任务" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                    android:textColor="@color/warning"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/space_8"/>
            </LinearLayout>

            <!-- 任务列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <!-- 空状态提示 -->
            <LinearLayout
                android:id="@+id/empty_tasks_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/space_32"
                android:visibility="visible">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_task"
                    android:alpha="0.3"
                    app:tint="@color/on_surface_tertiary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="还没有添加训练任务" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                    android:textColor="@color/on_surface_tertiary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="点击右上角‘添加任务’开始创建" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                    android:textColor="@color/on_surface_tertiary"
                />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_16"
        android:background="@color/surface"
        android:elevation="@dimen/elevation_1"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_save_draft"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_8"
            android:text="保存草稿" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
            android:textColor="@color/warning"
            android:background="@drawable/bg_button_secondary"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_activate_plan"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_8"
            android:text="激活计划" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
            android:textColor="@color/on_primary"
            android:background="@drawable/bg_button_primary"
            android:textStyle="bold"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>



