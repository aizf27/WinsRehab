<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_gradient_green">

    <!-- 1. 顶部 Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="@dimen/elevation_1"
        android:padding="@dimen/space_16"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="康复助手"
            android:textColor="@color/success" android:textAppearance="@style/TextAppearance.WinsRehab.Headline20"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <!-- 铃铛 + 红点 -->
<!--            <FrameLayout-->
<!--                android:layout_width="40dp"-->
<!--                android:layout_height="40dp"-->
<!--                android:background="?attr/selectableItemBackgroundBorderless"-->
<!--                android:clickable="true">-->

<!--                <ImageView-->
<!--                    android:layout_width="24dp"-->
<!--                    android:layout_height="24dp"-->
<!--                    android:layout_gravity="center"-->
<!--                    android:src="@drawable/ic_bell"-->
<!--                    app:tint="@color/on_surface_secondary" />-->

<!--                &lt;!&ndash; 红点 &ndash;&gt;-->
<!--                <View-->
<!--                    android:layout_width="8dp"-->
<!--                    android:layout_height="8dp"-->
<!--                    android:background="@drawable/shape_circle_red"-->
<!--                    android:layout_gravity="top|end"-->
<!--                    android:layout_marginTop="@dimen/space_8"-->
<!--                    android:layout_marginEnd="@dimen/space_8"/>-->
<!--            </FrameLayout>-->

<!--            <TextView-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginStart="@dimen/space_8"-->
<!--                android:background="@drawable/btn_outline_gray"-->
<!--                android:paddingHorizontal="@dimen/space_12"-->
<!--                android:paddingVertical="@dimen/space_4"-->
<!--                android:text="切换账户"-->
<!--                android:textColor="@color/on_surface_secondary"-->
<!-- android:textAppearance="@style/TextAppearance.WinsRehab.Body12"/>-->
        </LinearLayout>
    </LinearLayout>

    <!-- 2. 滚动内容 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- A. 欢迎卡片 (绿色渐变) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_24"
                app:cardCornerRadius="@dimen/radius_16"
                app:cardElevation="@dimen/elevation_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pt_welcome_green"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvGreeting"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="早上好"
                                android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"/>
                            <TextView
                                android:id="@+id/tvUserName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="张先生"
                                android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Headline20"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/tvRehabDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="今天是康复训练的第 28 天，继续加油！"
                                android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                                android:layout_marginTop="@dimen/space_4"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_activity"
                            android:alpha="0.8"
                            app:tint="@color/on_primary"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/surface_variant"
                        android:layout_marginVertical="@dimen/space_12"/>

                    <!-- 3列数据 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本周完成" android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="85%" android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Title16" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="累计天数" android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="28天" android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Title16" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今日任务" android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2/4" android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Title16" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- B. 今日任务 Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/space_12">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="今日任务"
                    android:textColor="@color/on_surface" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="查看全部"
                    android:textColor="@color/brand_patient_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"/>
            </LinearLayout>

            <!-- 任务 1 (绿色) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="@dimen/elevation_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 模拟 border-l-4 (绿色条) -->
                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="@color/brand_patient_primary_light"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/space_12">

                            <!-- 图标背景 -->
                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_circle_green_light">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_activity"
                                    app:tint="@color/brand_patient_primary"/>
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/space_12"
                                android:orientation="vertical">
                                <TextView android:text="上肢功能训练" android:textColor="@color/on_surface" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                <TextView android:text="建议时长：30分钟" android:textColor="@color/on_surface_secondary" android:textAppearance="@style/TextAppearance.WinsRehab.Body12" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="开始"
                                android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                                android:paddingHorizontal="@dimen/space_12"
                                android:paddingVertical="@dimen/space_4"
                                android:background="@drawable/bg_btn_green_small"/>
                        </LinearLayout>

                        <!-- 时间 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_clock" app:tint="@color/on_surface_secondary"/>
                            <TextView android:text="上午 10:00 - 10:30" android:textColor="@color/on_surface_secondary" android:textAppearance="@style/TextAppearance.WinsRehab.Body12" android:layout_marginStart="@dimen/space_4" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 任务 2 (黄色) - 可以复用上面的结构，只需改颜色 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_24"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="@dimen/elevation_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 模拟 border-l-4 (黄色条) -->
                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="@color/warning"/> <!-- yellow-400 -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/space_12">

                            <!-- 黄色背景圆圈 -->
                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_circle_yellow_light"> <!-- 需新建 yellow_light -->
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_activity"
                                    app:tint="@color/warning"/> <!-- yellow-600 -->
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/space_12"
                                android:orientation="vertical">
                                <TextView android:text="下肢平衡练习" android:textColor="@color/on_surface" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                <TextView android:text="建议时长：20分钟" android:textColor="@color/on_surface_secondary" android:textAppearance="@style/TextAppearance.WinsRehab.Body12" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="待完成"
                                android:textColor="@color/warning" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                                android:paddingHorizontal="@dimen/space_12"
                                android:paddingVertical="@dimen/space_4"
                                android:background="@drawable/bg_btn_outline_yellow"/> <!-- 需新建 -->
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_clock" app:tint="@color/on_surface_secondary"/>
                            <TextView android:text="下午 14:00 - 14:20" android:textColor="@color/on_surface_secondary" android:textAppearance="@style/TextAppearance.WinsRehab.Body12" android:layout_marginStart="@dimen/space_4" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- C. 功能卡片网格 (2x2) -->
            <!-- 行 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/space_16">

                <!-- 心理助手 (紫) -->
                <LinearLayout
                    android:id="@+id/cardPsychology"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_8"
                    android:background="@drawable/bg_gradient_pink"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/shape_circle_purple_light">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_psychology" android:layout_gravity="center" app:tint="@color/primary"/>
                        </FrameLayout>
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_chevron_right" app:tint="@color/primary"/>
                    </LinearLayout>

                    <TextView android:text="心理助手" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" android:textColor="@color/on_surface" android:layout_marginTop="@dimen/space_8" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="AI陪伴，倾听心声" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11" android:textColor="@color/on_surface_secondary" android:layout_marginBottom="@dimen/space_8" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_message" app:tint="@color/primary"/>
                        <TextView android:text="随时可用" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11" android:textColor="@color/primary" android:layout_marginStart="@dimen/space_4" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 视频库 (蓝) -->
                <LinearLayout
                    android:id="@+id/cardTraining"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_gradient_blue"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/shape_circle_blue_light">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_video" android:layout_gravity="center" app:tint="@color/primary"/>
                        </FrameLayout>
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_chevron_right" app:tint="@color/info"/>
                    </LinearLayout>

                    <TextView android:text="训练视频库" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" android:textColor="@color/on_surface" android:layout_marginTop="@dimen/space_8" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="专业指导视频" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11" android:textColor="@color/on_surface_secondary" android:layout_marginBottom="@dimen/space_8" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_play" app:tint="@color/primary"/>
                        <TextView android:text="120+ 视频" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11" android:textColor="@color/primary" android:layout_marginStart="@dimen/space_4" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 行 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/space_24">

                <!-- 病友社区 (橙) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_8"
                    android:background="@drawable/bg_gradient_yellow"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/shape_circle_orange_light">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_users" android:layout_gravity="center" app:tint="@color/warning"/>
                        </FrameLayout>
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_chevron_right" app:tint="@color/warning"/>
                    </LinearLayout>
                    <TextView android:text="病友社区" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" android:textColor="@color/on_surface" android:layout_marginTop="@dimen/space_8" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="分享经验，互相鼓励" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11" android:textColor="@color/on_surface_secondary" android:layout_marginBottom="@dimen/space_8" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_trophy" app:tint="@color/warning"/>
                        <TextView android:text="排行榜" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11" android:textColor="@color/warning" android:layout_marginStart="@dimen/space_4" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 医生反馈 (青) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_gradient_teal"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/shape_circle_teal_light">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_stethoscope" android:layout_gravity="center" app:tint="@color/success"/>
                        </FrameLayout>
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                        <!-- 红色徽标 -->
                        <TextView android:text="3" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11" android:textColor="@color/on_primary" android:background="@drawable/shape_circle_red" android:paddingHorizontal="@dimen/space_4" android:paddingVertical="@dimen/space_4" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <TextView android:text="医生反馈" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" android:textColor="@color/on_surface" android:layout_marginTop="@dimen/space_8" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="李医生的专业建议" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11" android:textColor="@color/on_surface_secondary" android:layout_marginBottom="@dimen/space_8" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_message" app:tint="@color/success"/>
                        <TextView android:text="3条新消息" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11" android:textColor="@color/success" android:layout_marginStart="@dimen/space_4" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- D. 康复进度 (图表) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本周康复进度"
                android:textColor="@color/on_surface" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/space_16"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_24"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="@dimen/elevation_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_24">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/space_16">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
