<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="@dimen/elevation_1"
        android:gravity="center_vertical"
        android:padding="@dimen/space_16"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="康复助手"
            android:textAppearance="@style/TextAppearance.WinsRehab.Headline20"
            android:textColor="@color/success"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_24"
                app:cardCornerRadius="@dimen/radius_16"
                app:cardElevation="@dimen/elevation_1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pt_welcome_green"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <TextView android:id="@+id/tvGreeting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" android:textColor="@color/on_primary" />
                    <TextView android:id="@+id/tvUserName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:textAppearance="@style/TextAppearance.WinsRehab.Headline20" android:textColor="@color/on_primary" android:textStyle="bold" />
                    <TextView android:id="@+id/tvRehabDay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:textAppearance="@style/TextAppearance.WinsRehab.Body12" android:textColor="@color/on_primary" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本周完成" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11" android:textColor="@color/on_primary" />
                            <TextView android:id="@+id/tvWeekPercent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.WinsRehab.Title16" android:textColor="@color/on_primary" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="累计天数" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11" android:textColor="@color/on_primary" />
                            <TextView android:id="@+id/tvTotalDays" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.WinsRehab.Title16" android:textColor="@color/on_primary" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今日任务" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11" android:textColor="@color/on_primary" />
                            <TextView android:id="@+id/tvTodayTasks" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.WinsRehab.Title16" android:textColor="@color/on_primary" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="@dimen/space_8">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="今日任务" android:textAppearance="@style/TextAppearance.WinsRehab.Title16" android:textColor="@color/on_surface" android:textStyle="bold" />
                <TextView android:id="@+id/tvViewAllTasks" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="查看全部" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" android:textColor="@color/brand_patient_primary_dark" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvHomeTasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
            <TextView android:id="@+id/tvHomeEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="@dimen/space_24" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" android:textColor="@color/on_surface_secondary" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:layout_marginBottom="@dimen/space_8" android:text="服务" android:textAppearance="@style/TextAppearance.WinsRehab.Title16" android:textColor="@color/on_surface" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardTraining" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/space_8" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardCornerRadius="@dimen/radius_12"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_16"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="训练视频" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" android:textColor="@color/on_surface"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="查看示范训练" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11" android:textColor="@color/on_surface_secondary"/></LinearLayout></com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardPsychology" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardCornerRadius="@dimen/radius_12"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_16"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="心理助手" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" android:textColor="@color/on_surface"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI 陪伴，倾听心声" android:textAppearance="@style/TextAppearance.WinsRehab.Caption11" android:textColor="@color/on_surface_secondary"/></LinearLayout></com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/space_8" android:layout_weight="1" android:alpha="0.5" android:enabled="false" app:cardCornerRadius="@dimen/radius_12"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/space_16" android:text="病友社区\n即将开放" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" android:textColor="@color/on_surface_secondary" /></com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:alpha="0.5" android:enabled="false" app:cardCornerRadius="@dimen/radius_12"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/space_16" android:text="医生反馈\n即将开放" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" android:textColor="@color/on_surface_secondary" /></com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:layout_marginBottom="@dimen/space_8" android:text="本周康复进度" android:textAppearance="@style/TextAppearance.WinsRehab.Title16" android:textColor="@color/on_surface" android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="@dimen/radius_12">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_16">
                    <TextView android:id="@+id/tvWeekProgressPercent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.WinsRehab.Display24" android:textColor="@color/brand_patient_primary" android:textStyle="bold" />
                    <ProgressBar android:id="@+id/progressWeek" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="@dimen/space_8" android:progressDrawable="@drawable/custom_progress_bar_green" />
                    <TextView android:id="@+id/tvWeekCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:textAppearance="@style/TextAppearance.WinsRehab.Body12" android:textColor="@color/on_surface_secondary" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:baselineAligned="false" android:orientation="horizontal">
                        <include android:id="@+id/homeWeekBar1" layout="@layout/item_week_bar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <include android:id="@+id/homeWeekBar2" layout="@layout/item_week_bar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <include android:id="@+id/homeWeekBar3" layout="@layout/item_week_bar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <include android:id="@+id/homeWeekBar4" layout="@layout/item_week_bar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <include android:id="@+id/homeWeekBar5" layout="@layout/item_week_bar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <include android:id="@+id/homeWeekBar6" layout="@layout/item_week_bar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <include android:id="@+id/homeWeekBar7" layout="@layout/item_week_bar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:layout_marginBottom="@dimen/space_8" android:text="快捷功能" android:textAppearance="@style/TextAppearance.WinsRehab.Title16" android:textColor="@color/on_surface" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/space_8" android:layout_weight="1" android:alpha="0.65" android:enabled="false" android:gravity="center" android:padding="@dimen/space_16" android:text="训练日历\n即将开放" android:textAppearance="@style/TextAppearance.WinsRehab.Body12" android:textColor="@color/on_surface" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/space_8" android:layout_weight="1" android:alpha="0.65" android:enabled="false" android:gravity="center" android:padding="@dimen/space_16" android:text="健康数据\n即将开放" android:textAppearance="@style/TextAppearance.WinsRehab.Body12" android:textColor="@color/on_surface" />
                <TextView android:id="@+id/cardRehab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:padding="@dimen/space_16" android:text="康复中心" android:textAppearance="@style/TextAppearance.WinsRehab.Body12" android:textColor="@color/brand_patient_primary_dark" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
