<?xml version="1.0" encoding="utf-8"?>
<!-- 患者列表项布局 - 用于医生端选择患者创建计划 -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_8"
    app:cardCornerRadius="@dimen/radius_12"
    app:cardElevation="@dimen/elevation_1"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_16"
        android:gravity="center_vertical">

        <!-- 头像 -->
        <androidx.cardview.widget.CardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="@dimen/radius_16"
            app:cardElevation="@dimen/elevation_0"
            app:cardBackgroundColor="@color/surface_variant">

            <ImageView
                android:id="@+id/img_patient_avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_user"
                app:tint="@color/warning"/>
        </androidx.cardview.widget.CardView>

        <!-- 患者信息 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_12"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_patient_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="患者姓名" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                android:textStyle="bold"
                android:textColor="@color/on_surface"/>

            <TextView
                android:id="@+id/tv_patient_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="诊断信息" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                android:textColor="@color/on_surface_secondary"/>

            <TextView
                android:id="@+id/tv_rehab_stage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="康复阶段" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                android:textColor="@color/on_surface_tertiary"/>
        </LinearLayout>

        <!-- 右侧箭头 -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/on_surface_tertiary"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>



