<?xml version="1.0" encoding="utf-8"?>
<!-- 患者管理页：标题 + 患者总数 + 已绑定患者列表，搜索框（无数据支撑）已移除 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_gradient_blue">

    <!-- 顶部固定区：标题 + 与首页同口径的患者总数 -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="@dimen/elevation_1"
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="患者管理"
            android:textAppearance="@style/TextAppearance.WinsRehab.Headline20"
            android:textColor="@color/brand_doctor_primary_dark"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_patient_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
            android:textColor="@color/on_surface_secondary"
            tools:text="共 0 位患者" />
    </LinearLayout>

    <!-- 患者列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_patients"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout" />

    <!-- 三态：加载中 / 空态，两个都换成统一组件 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout">

        <include
            android:id="@+id/state_patients_loading"
            layout="@layout/widget_state_loading" />

        <include
            android:id="@+id/state_patients_empty"
            layout="@layout/widget_state_empty"
            android:visibility="gone" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
