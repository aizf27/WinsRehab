<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 背景图片 -->
    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_dtlog"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 滚动内容 -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_24"
            android:gravity="center_horizontal">

            <!-- 顶部标题：医生登录 -->


            <!-- 副标题 -->
            <TextView
                android:id="@+id/tvDoctorLoginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginTop="@dimen/space_32"
                android:text="@string/title_dotlog"
                android:textColor="@color/on_surface" android:textAppearance="@style/TextAppearance.WinsRehab.Display24"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDoctorLoginSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:text="@string/dotlog_Inspirational_words" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_marginTop="@dimen/space_8"/>

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:layout_marginTop="@dimen/space_24"
                android:layout_gravity="left">

                <!-- 图片 -->
                <ImageView
                    android:id="@+id/imgDoctorLoginBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/shape_round_image"
                    android:clipToOutline="true"
                    android:src="@drawable/img_dtlook"/>
                <!-- 叠加文字 -->
                <TextView
                    android:id="@+id/tvBannerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:text="@string/dotlog_theme"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="@color/on_surface"
                    android:paddingHorizontal="@dimen/space_8"
                    android:paddingVertical="@dimen/space_4"
                    android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                    android:textStyle="bold" />
            </FrameLayout>
            <!-- 输入框容器 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:layout_marginTop="@dimen/space_32">

                <!-- 工号输入 -->
                <EditText
                    android:id="@+id/etDoctorId"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="@dimen/space_8"
                    android:hint="工号"
                    android:drawableStart="@drawable/baseline_account_box_24"
                    android:drawablePadding="@dimen/space_12"
                    android:background="@drawable/shape_edittext_bg"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"/>

                <!-- 密码输入 -->
                <EditText
                    android:id="@+id/etDoctorPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="密码"
                    android:drawableStart="@drawable/baseline_lock_24"
                    android:drawablePadding="@dimen/space_12"
                    android:background="@drawable/shape_edittext_bg"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:inputType="textPassword" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                    android:layout_marginTop="@dimen/space_16"/>
                <CheckBox
                    android:id="@+id/cbRememberPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="记住密码"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                    android:layout_marginTop="@dimen/space_4"
                    android:theme="@style/MyCheckBox"
                    />

            </LinearLayout>

            <!-- 登录按钮 -->
            <Button
                android:id="@+id/btnDoctorLogin"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="登录"
                android:backgroundTint="@color/brand_doctor_primary"
                style="@style/MyRoundButton"
                android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                android:layout_marginTop="@dimen/space_24"/>

            <Button
                android:id="@+id/btnDoctorRegister"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="注册"
                android:textColor="@color/on_surface" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                android:layout_marginTop="@dimen/space_16"
                android:backgroundTint="@color/outline"
                style="@style/MyRoundButton"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
