<?xml version="1.0" encoding="utf-8"?>
<!-- 医生首页：欢迎卡接真实计数，四宫格两个可用两个置灰，底部为最新患者申请列表 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/doctorHomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant"
    android:orientation="vertical">

    <!-- 标题栏：只保留页面标题，原来的无功能搜索框已移除 -->
    <TextView
        android:id="@+id/tvHomeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="@dimen/elevation_1"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_16"
        android:text="@string/doctor_home_title"
        android:textAppearance="@style/TextAppearance.WinsRehab.Headline20"
        android:textColor="@color/on_surface"
        android:textStyle="bold" />

    <!-- 待办横幅：有待处理申请才显示，与欢迎卡的「待处理」同源 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutNotification"
        style="@style/Widget.WinsRehab.Card.Clickable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_16"
        android:visibility="gone"
        app:cardBackgroundColor="@color/warning_container"
        app:cardElevation="@dimen/elevation_0"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_12">

            <ImageView
                android:layout_width="@dimen/space_24"
                android:layout_height="@dimen/space_24"
                android:contentDescription="@null"
                android:src="@drawable/ic_bell"
                app:tint="@color/warning" />

            <TextView
                android:id="@+id/tvNotification"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                android:textColor="@color/warning"
                tools:text="您有 2 个新患者申请" />

            <TextView
                android:id="@+id/btnViewApplications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_4"
                android:text="@string/doctor_home_view_more"
                android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                android:textColor="@color/brand_doctor_primary_dark"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 欢迎卡：管理患者与待处理接真实数据，待审核暂无数据源用统一占位 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginEnd="@dimen/space_16"
                android:background="@drawable/bg_brand_gradient"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.WinsRehab.Headline20"
                    android:textColor="@color/on_primary"
                    android:textStyle="bold"
                    tools:text="早上好" />

                <TextView
                    android:id="@+id/tvBrief"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                    android:textColor="@color/on_primary"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="今天有 2 个患者申请待处理"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPatientCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                            android:textColor="@color/on_primary"
                            android:textStyle="bold"
                            tools:text="3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/doctor_home_stat_patients"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                            android:textColor="@color/on_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvReviewCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                            android:textColor="@color/on_primary"
                            android:textStyle="bold"
                            tools:text="--" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/doctor_home_stat_review"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                            android:textColor="@color/on_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPendingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                            android:textColor="@color/on_primary"
                            android:textStyle="bold"
                            tools:text="2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/doctor_home_stat_pending"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                            android:textColor="@color/on_primary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 核心功能：管理患者与制定计划可点，审核视频与患者反馈置灰待开放 -->
            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginEnd="@dimen/space_16"
                android:text="@string/doctor_home_section_functions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginEnd="@dimen/space_16"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPatientManage"
                    style="@style/Widget.WinsRehab.Card.Clickable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_12"
                    android:layout_weight="1"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <ImageView
                            android:layout_width="@dimen/space_48"
                            android:layout_height="@dimen/space_48"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/primary_container"
                            android:contentDescription="@null"
                            android:padding="@dimen/space_12"
                            android:src="@drawable/ic_users"
                            app:tint="@color/brand_doctor_primary_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="@string/doctor_home_manage_patients"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                            android:textColor="@color/on_surface"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvManagePatientsSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                            android:textColor="@color/on_surface_secondary"
                            tools:text="3 位患者" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReviewVideo"
                    style="@style/Widget.WinsRehab.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="false"
                    android:focusable="false"
                    app:cardBackgroundColor="@color/disabled_bg"
                    app:cardElevation="@dimen/elevation_0"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <ImageView
                            android:layout_width="@dimen/space_48"
                            android:layout_height="@dimen/space_48"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/divider"
                            android:contentDescription="@null"
                            android:padding="@dimen/space_12"
                            android:src="@drawable/ic_video"
                            app:tint="@color/disabled_fg" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="@string/doctor_home_review_video"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                            android:textColor="@color/on_surface_tertiary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/doctor_home_coming_soon"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                            android:textColor="@color/disabled_fg" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginEnd="@dimen/space_16"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCreatePlan"
                    style="@style/Widget.WinsRehab.Card.Clickable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_12"
                    android:layout_weight="1"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <ImageView
                            android:layout_width="@dimen/space_48"
                            android:layout_height="@dimen/space_48"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/success_container"
                            android:contentDescription="@null"
                            android:padding="@dimen/space_12"
                            android:src="@drawable/ic_clipboard_list"
                            app:tint="@color/brand_patient_primary_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="@string/doctor_home_create_plan"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                            android:textColor="@color/on_surface"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/doctor_home_create_plan_subtitle"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                            android:textColor="@color/on_surface_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFeedback"
                    style="@style/Widget.WinsRehab.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="false"
                    android:focusable="false"
                    app:cardBackgroundColor="@color/disabled_bg"
                    app:cardElevation="@dimen/elevation_0"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <ImageView
                            android:layout_width="@dimen/space_48"
                            android:layout_height="@dimen/space_48"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/divider"
                            android:contentDescription="@null"
                            android:padding="@dimen/space_12"
                            android:src="@drawable/ic_message_square"
                            app:tint="@color/disabled_fg" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="@string/doctor_home_feedback"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                            android:textColor="@color/on_surface_tertiary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/doctor_home_coming_soon"
                            android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                            android:textColor="@color/disabled_fg" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 最新患者申请：接真实待办查询，按申请时间倒序 -->
            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginEnd="@dimen/space_16"
                android:text="@string/doctor_home_section_applications" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvApplications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16" />

            <!-- 空态：没有待处理申请时占位，列表隐藏 -->
            <include
                android:id="@+id/stateApplicationsEmpty"
                layout="@layout/widget_state_empty"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
