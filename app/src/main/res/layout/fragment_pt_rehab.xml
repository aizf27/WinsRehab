<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant"> <!-- bg-green-50 -->

    <!-- 1. 顶部 Header (Sticky) -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="@dimen/elevation_1"
        android:padding="@dimen/space_16"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 左侧 Icon -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_circle_green_light">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_activity"
                app:tint="@color/brand_patient_primary" />
        </FrameLayout>

        <!-- 标题文字 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_12"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="康复中心"
                android:textColor="@color/success" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvRehabDay"
                android:text="--"
                android:textColor="@color/on_surface_secondary" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"/>
        </LinearLayout>

        <!-- 切换账户按钮 -->
<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:background="@drawable/btn_outline_gray"-->
<!--            android:paddingHorizontal="@dimen/space_12"-->
<!--            android:paddingVertical="@dimen/space_4"-->
<!--            android:text="切换账户"-->
<!--            android:textColor="@color/on_surface_secondary"-->
<!-- android:textAppearance="@style/TextAppearance.WinsRehab.Body12"/>-->
    </LinearLayout>

    <!-- 2. 滚动内容 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- A. 今日进度卡片 (Gradient Card) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_24"
                app:cardCornerRadius="@dimen/radius_16"
                app:cardElevation="@dimen/elevation_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pt_welcome_green"
                    android:orientation="vertical"
                    android:padding="@dimen/space_24">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="今日训练进度"
                                android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"/>
                            <TextView
                                android:id="@+id/tvProgressCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2/4 项已完成"
                                android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Headline20"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/space_4"
                                android:layout_marginBottom="@dimen/space_8"/>
                            <TextView
                                android:id="@+id/tvProgressPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="完成率: 50%"
                                android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_trending_up"
                            app:tint="@color/on_primary"/>
                    </LinearLayout>

                    <!-- 进度条 -->
                    <ProgressBar
                        android:id="@+id/progressBarToday"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="@dimen/space_16"
                        android:progressDrawable="@drawable/custom_progress_bar_white"
                        android:progress="50"
                        android:max="100"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- B. 录制操作卡片 (包含两个状态) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_24"
                app:cardCornerRadius="@dimen/radius_16"
                app:cardElevation="@dimen/elevation_1"
                app:cardBackgroundColor="@color/surface">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_24">

                    <!-- 状态 1: 未录制 (默认显示) -->
                    <LinearLayout
                        android:id="@+id/layoutStateIdle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="visible"> <!-- 控制这里的 visibility -->

                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="@drawable/shape_circle_green_light"
                            android:layout_marginBottom="@dimen/space_16">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_video"
                                app:tint="@color/brand_patient_primary"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="开始康复训练"
                            android:textColor="@color/on_surface" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="点击开始录制您的康复训练视频"
                            android:textColor="@color/on_surface_secondary" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                            android:layout_marginBottom="@dimen/space_24"
                            android:layout_marginTop="@dimen/space_8"/>

                        <Button
                            android:id="@+id/btnStartRecord"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:enabled="false"
                            android:text="即将开放" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                            android:textColor="@color/on_primary"
                            android:background="@drawable/bg_btn_green_rounded"/>
                    </LinearLayout>

                    <!-- 状态 2: 录制中 (默认隐藏) -->
                    <LinearLayout
                        android:id="@+id/layoutStateRecording"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone"> <!-- 控制这里的 visibility -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_gray_rounded"
                            android:padding="@dimen/space_32"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_marginBottom="@dimen/space_16">

                            <!-- 红色脉冲圆圈 -->
                            <FrameLayout
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@drawable/shape_circle_red">
                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_video"
                                    app:tint="@color/on_primary"/>
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="录制中..."
                                android:layout_marginTop="@dimen/space_12"
                                android:textColor="@color/on_surface_secondary" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"/>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnStopRecord"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:enabled="false"
                            android:text="即将开放" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                            android:textColor="@color/on_primary"
                            android:background="@drawable/bg_btn_red_rounded"/> <!-- Red-500 -->
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- C. 今日训练计划列表 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日训练计划"
                android:textColor="@color/on_surface" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/space_16"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_24">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTodayTasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_24"
                    android:gravity="center"
                    android:text="今天还没有训练任务"
                    android:textColor="@color/on_surface_secondary" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                    android:visibility="gone"/>

                <ProgressBar
                    android:id="@+id/loadingView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/errorView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/space_24"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="加载失败"
                        android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                        android:textColor="@color/danger"/>

                    <Button
                        android:id="@+id/btnRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:textColor="@color/on_surface" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                        android:text="重试"/>
                </LinearLayout>
            </FrameLayout>

            <!-- D. 本周完成情况 (柱状图) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本周完成情况"
                android:textColor="@color/on_surface" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/space_16"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_24"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="@dimen/elevation_1"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_24"
                    android:baselineAligned="false">

                    <!-- 使用 weight=1 均分7天 -->
                    <include layout="@layout/item_week_bar" android:id="@+id/weekBar1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                    <include layout="@layout/item_week_bar" android:id="@+id/weekBar2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                    <include layout="@layout/item_week_bar" android:id="@+id/weekBar3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                    <include layout="@layout/item_week_bar" android:id="@+id/weekBar4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                    <include layout="@layout/item_week_bar" android:id="@+id/weekBar5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                    <include layout="@layout/item_week_bar" android:id="@+id/weekBar6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                    <include layout="@layout/item_week_bar" android:id="@+id/weekBar7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- E. 底部统计格子 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <include layout="@layout/item_stat_card" android:id="@+id/statCard1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="@dimen/space_8"/>
                <include layout="@layout/item_stat_card" android:id="@+id/statCard2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="@dimen/space_8"/>
                <include layout="@layout/item_stat_card" android:id="@+id/statCard3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
