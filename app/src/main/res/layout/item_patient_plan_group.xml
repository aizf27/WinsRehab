<?xml version="1.0" encoding="utf-8"?>
<!-- 患者计划分组项 - 显示患者信息和其计划列表 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="@dimen/space_16">

    <!-- 患者信息头部 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_8"
        app:cardCornerRadius="@dimen/radius_12"
        app:cardElevation="@dimen/elevation_1"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/patient_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/space_16"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground">

            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="@dimen/radius_16"
                app:cardElevation="@dimen/elevation_0"
                app:cardBackgroundColor="@color/surface_variant">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_user"
                    app:tint="@color/warning"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_12"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_patient_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="患者姓名" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"/>

                <TextView
                    android:id="@+id/tv_plan_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="3个康复计划" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                    android:textColor="@color/on_surface_secondary"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_create_plan"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_add"
                android:padding="@dimen/space_8"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/warning"/>

            <ImageView
                android:id="@+id/iv_expand"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/on_surface_tertiary"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 计划列表（可展开/收起） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_plans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:nestedScrollingEnabled="false"
        android:visibility="gone"/>
</LinearLayout>



