<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    app:cardCornerRadius="@dimen/radius_8"
    app:cardElevation="@dimen/elevation_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="@color/info"
                android:layout_marginEnd="@dimen/space_12"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPatientName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="患者姓名" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"/>

                <TextView
                    android:id="@+id/tvPatientAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="账号：13800138000" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                    android:textColor="@color/on_surface_secondary"
                    android:layout_marginTop="@dimen/space_4"/>

                <TextView
                    android:id="@+id/tvApplyTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="申请时间：2小时前" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                    android:textColor="@color/on_surface_tertiary"
                    android:layout_marginTop="@dimen/space_4"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="end">

            <Button
                android:id="@+id/btnReject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拒绝"
                android:backgroundTint="@color/danger"
                android:layout_marginEnd="@dimen/space_8"

                />

            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="确认"
                android:backgroundTint="@color/success"

                />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>





