<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant">

    <!-- 1. 顶部标题栏 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:elevation="@dimen/elevation_1"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="个人信息"
            android:textColor="@color/brand_doctor_primary_dark" android:textAppearance="@style/TextAppearance.WinsRehab.Headline20"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="@dimen/space_16" />

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_16"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/space_8"
            android:text="编辑"
            android:textColor="@color/brand_doctor_primary_dark" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. 中间滚动区域 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- === 医生个人资料卡片 === -->
            <androidx.cardview.widget.CardView
                android:id="@+id/profileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_24"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_16"
                app:cardElevation="@dimen/elevation_1">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_brand_gradient"
                    android:padding="@dimen/space_24">

                    <!-- 头像圆底：白色正圆 + 品牌色图标，圆形用 oval 表达不占圆角档 -->
                    <FrameLayout
                        android:id="@+id/avatar_container"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_avatar_circle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_user"
                            app:tint="@color/primary"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/avatar_container"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tvDoctorName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未设置"
                            android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Headline20"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDoctorInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="性别 · 年龄 · 科室"
                            android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" />

                        <TextView
                            android:id="@+id/tvDoctorCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="工号：未设置"
                            android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- === 执业信息 === -->
            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:text="执业信息" />

            <androidx.cardview.widget.CardView
                style="@style/InfoCardStyle">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/widget_info_row" android:id="@+id/row_license"/>
                    <View style="@style/Divider"/>

                    <include layout="@layout/widget_info_row" android:id="@+id/row_hospital"/>
                    <View style="@style/Divider"/>

                    <include layout="@layout/widget_info_row" android:id="@+id/row_title"/>
                    <View style="@style/Divider"/>

                    <include layout="@layout/widget_info_row" android:id="@+id/row_patient_count"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- === 联系方式 === -->
            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:text="联系方式" />

            <androidx.cardview.widget.CardView
                style="@style/InfoCardStyle">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/widget_info_row" android:id="@+id/row_phone"/>
                    <View style="@style/Divider"/>

                    <include layout="@layout/widget_info_row" android:id="@+id/row_email"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- === 工作统计 (Grid) === -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginBottom="@dimen/space_12"
                android:text="工作统计"
                android:textColor="@color/on_surface" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_8"
                    app:cardCornerRadius="@dimen/radius_12"
                    app:cardElevation="@dimen/elevation_1"
                    app:contentPadding="@dimen/space_16">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="本月完成" android:textColor="@color/on_surface_secondary" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"/>
                        <TextView
                            android:id="@+id/tvMonthlyPlans"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textColor="@color/primary" android:textAppearance="@style/TextAppearance.WinsRehab.Display24" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="康复计划" android:textColor="@color/on_surface_secondary" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_8"
                    app:cardCornerRadius="@dimen/radius_12"
                    app:cardElevation="@dimen/elevation_1"
                    app:contentPadding="@dimen/space_16">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="患者满意度" android:textColor="@color/on_surface_secondary" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"/>
                        <TextView
                            android:id="@+id/tvSatisfaction"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textColor="@color/primary" android:textAppearance="@style/TextAppearance.WinsRehab.Display24" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="综合评分" android:textColor="@color/on_surface_secondary" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- === 设置 === -->
            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:text="设置" />

            <androidx.cardview.widget.CardView
                style="@style/InfoCardStyle">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/item_info_row" android:id="@+id/row_report"/>
                    <View style="@style/Divider"/>

                    <include layout="@layout/item_info_row" android:id="@+id/row_settings"/>
                    <View style="@style/Divider"/>

                    <!-- 切换账户 (红色特殊样式) -->
                    <LinearLayout
                        android:id="@+id/btn_logout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_16"
                        android:background="?attr/selectableItemBackground">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_logout" app:tint="@color/danger"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_12" android:text="切换账户" android:textColor="@color/danger" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"/>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" app:tint="@color/on_surface_tertiary"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>