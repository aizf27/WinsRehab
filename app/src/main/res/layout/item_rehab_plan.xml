<?xml version="1.0" encoding="utf-8"?>
<!-- 康复计划项布局 - 按患者分组显示 -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_8"
    app:cardCornerRadius="@dimen/radius_16"
    app:cardElevation="@dimen/elevation_1"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部渐变背景 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_brand_gradient"
            android:padding="@dimen/space_16"
            android:orientation="vertical">

            <!-- 计划名称 -->
            <TextView
                android:id="@+id/tv_plan_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="康复计划名称" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
                android:textStyle="bold"
                android:textColor="@color/on_primary"/>

            <!-- 康复目标 -->
            <TextView
                android:id="@+id/tv_plan_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="康复目标" android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
                android:textColor="@color/on_primary"/>
        </LinearLayout>

        <!-- 计划详情 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_16"
            android:orientation="vertical">

            <!-- 状态和进度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_plan_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="进行中" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                    android:textColor="@color/status_pending"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="@color/primary_container"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="@dimen/space_4"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tv_plan_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="进度 0%" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                    android:textColor="@color/warning"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- 时间信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/on_surface_tertiary"/>

                <TextView
                    android:id="@+id/tv_plan_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:text="2024-01-01 至 2024-03-01" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                    android:textColor="@color/on_surface_secondary"/>
            </LinearLayout>

            <!-- 任务数量 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_task"
                    app:tint="@color/on_surface_tertiary"/>

                <TextView
                    android:id="@+id/tv_task_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:text="包含 5 个训练任务" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                    android:textColor="@color/on_surface_secondary"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>



