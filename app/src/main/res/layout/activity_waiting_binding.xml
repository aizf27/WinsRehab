<?xml version="1.0" encoding="utf-8"?>
<!-- 等待绑定页：同一页面按「等待中 / 已通过 / 被拒绝」三态切换徽标、文案与按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- 顶部栏：标题固定为绑定医生，返回关闭本页 -->
    <include
        android:id="@+id/topBar"
        layout="@layout/widget_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_32">

        <!-- 状态图标：三态换图标与颜色，形状圆底保持统一 -->
        <ImageView
            android:id="@+id/ivStateIcon"
            android:layout_width="@dimen/space_48"
            android:layout_height="@dimen/space_48"
            android:background="@drawable/bg_circle"
            android:contentDescription="@null"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_heart_beat"
            app:tint="@color/warning" />

        <!-- 状态徽标：文字与配色由 StatusBadge 按绑定状态绑定 -->
        <include
            android:id="@+id/statusBadge"
            layout="@layout/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16" />

        <TextView
            android:id="@+id/tvStateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center"
            android:text="@string/waiting_pending_title"
            android:textAppearance="@style/TextAppearance.WinsRehab.Headline20"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStateDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="@string/waiting_pending_desc"
            android:textAppearance="@style/TextAppearance.WinsRehab.Body14"
            android:textColor="@color/on_surface_secondary" />

        <!-- 仅等待中显示进度圈，避免已出结果还在转 -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/tvStateHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center"
            android:text="@string/waiting_pending_hint"
            android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
            android:textColor="@color/on_surface_tertiary" />

        <!-- 主按钮：等待中是刷新、已通过是进入首页、被拒绝是重新申请 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimary"
            style="@style/Widget.WinsRehab.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:text="@string/action_refresh_status" />

        <!-- 次按钮：回到登录页重新走一遍流程 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSecondary"
            style="@style/Widget.WinsRehab.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/action_back_to_login" />
    </LinearLayout>
</LinearLayout>
