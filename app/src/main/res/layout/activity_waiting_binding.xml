<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/space_32"
    android:background="@color/surface_variant">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@android:drawable/ic_dialog_info"
        app:tint="@color/warning"
        android:layout_marginBottom="@dimen/space_24"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="等待医生确认中..." android:textAppearance="@style/TextAppearance.WinsRehab.Display24"
        android:textStyle="bold"
        android:textColor="@color/on_surface"
        android:layout_marginBottom="@dimen/space_16"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="已向医生发送绑定申请" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
        android:textColor="@color/on_surface_secondary"
        android:layout_marginBottom="@dimen/space_8"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="请耐心等待医生确认" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
        android:textColor="@color/on_surface_secondary"
        android:layout_marginBottom="@dimen/space_32"/>

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:layout_marginBottom="@dimen/space_32"/>

    <Button
        android:id="@+id/btnRefresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="刷新状态" android:textAppearance="@style/TextAppearance.WinsRehab.Title16"
        android:paddingHorizontal="@dimen/space_32"
        android:paddingVertical="@dimen/space_12"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="系统会每30秒自动刷新状态" android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
        android:textColor="@color/on_surface_tertiary"
        android:layout_marginTop="@dimen/space_16"/>

</LinearLayout>





