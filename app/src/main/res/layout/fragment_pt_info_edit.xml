<?xml version="1.0" encoding="utf-8"?>
<!-- 患者信息编辑页：信息行展示，点可编辑行弹统一输入框 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="@dimen/elevation_1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <include
            android:id="@+id/topBar"
            layout="@layout/widget_top_bar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.WinsRehab.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_8"
            android:text="保存" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <LinearLayout
                android:id="@+id/layoutAvatar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_8">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_avatar_circle">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="头像"
                        android:src="@drawable/ic_user"
                        app:tint="@color/brand_patient_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="点击更换头像"
                    android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                    android:textColor="@color/on_surface_secondary" />
            </LinearLayout>

            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="基本信息" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WinsRehab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPaddingLeft="@dimen/space_16"
                app:contentPaddingRight="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include android:id="@+id/layoutName" layout="@layout/widget_info_row" />
                    <View style="@style/Divider" />
                    <include android:id="@+id/layoutGender" layout="@layout/widget_info_row" />
                    <View style="@style/Divider" />
                    <include android:id="@+id/layoutAge" layout="@layout/widget_info_row" />
                    <View style="@style/Divider" />
                    <include android:id="@+id/layoutNickname" layout="@layout/widget_info_row" />
                    <View style="@style/Divider" />
                    <include android:id="@+id/layoutSignature" layout="@layout/widget_info_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="联系方式" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WinsRehab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPaddingLeft="@dimen/space_16"
                app:contentPaddingRight="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include android:id="@+id/layoutPhone" layout="@layout/widget_info_row" />
                    <View style="@style/Divider" />
                    <include android:id="@+id/layoutEmail" layout="@layout/widget_info_row" />
                    <View style="@style/Divider" />
                    <include android:id="@+id/layoutDateOfBirth" layout="@layout/widget_info_row" />
                    <View style="@style/Divider" />
                    <include android:id="@+id/layoutAddress" layout="@layout/widget_info_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="医生信息" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WinsRehab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPaddingLeft="@dimen/space_16"
                app:contentPaddingRight="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include android:id="@+id/rowDoctorName" layout="@layout/widget_info_row" />
                    <View style="@style/Divider" />
                    <include android:id="@+id/rowDoctorCode" layout="@layout/widget_info_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="康复信息" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WinsRehab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPaddingLeft="@dimen/space_16"
                app:contentPaddingRight="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include android:id="@+id/rowDiagnosis" layout="@layout/widget_info_row" />
                    <View style="@style/Divider" />
                    <include android:id="@+id/rowStage" layout="@layout/widget_info_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_24"
                android:text="医生与康复信息由系统维护，无法修改"
                android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                android:textColor="@color/on_surface_tertiary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
