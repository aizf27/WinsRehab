<?xml version="1.0" encoding="utf-8"?><!-- 医生信息编辑页：顶部栏 + 只读信息行，点行弹窗改值 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant"
    android:orientation="vertical">

    <!-- 顶部栏：返回 + 标题 + 保存 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="@dimen/elevation_1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <include
            android:id="@+id/topBar"
            layout="@layout/widget_top_bar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.WinsRehab.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_8"
            android:text="保存" />
    </LinearLayout>

    <!-- 缺少医生工号时的明确空态 -->
    <include
        android:id="@+id/stateEmpty"
        layout="@layout/widget_state_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- 头像区：暂未接上传，点击给出提示 -->
            <LinearLayout
                android:id="@+id/layoutAvatar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_8">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_avatar_circle">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="头像"
                        android:src="@drawable/ic_user"
                        app:tint="@color/brand_doctor_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="点击更换头像"
                    android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                    android:textColor="@color/on_surface_secondary" />
            </LinearLayout>

            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="基本信息" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WinsRehab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPaddingLeft="@dimen/space_16"
                app:contentPaddingRight="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 姓名：点行弹窗修改 -->
                    <include
                        android:id="@+id/layoutName"
                        layout="@layout/widget_info_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/Divider" />

                    <!-- 性别：单选弹窗 -->
                    <include
                        android:id="@+id/layoutGender"
                        layout="@layout/widget_info_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/Divider" />

                    <!-- 年龄：数字输入弹窗 -->
                    <include
                        android:id="@+id/layoutAge"
                        layout="@layout/widget_info_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="执业信息" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WinsRehab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPaddingLeft="@dimen/space_16"
                app:contentPaddingRight="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/layoutDepartment"
                        layout="@layout/widget_info_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/Divider" />

                    <include
                        android:id="@+id/layoutTitle"
                        layout="@layout/widget_info_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/Divider" />

                    <include
                        android:id="@+id/layoutHospital"
                        layout="@layout/widget_info_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/Divider" />

                    <include
                        android:id="@+id/layoutLicenseNumber"
                        layout="@layout/widget_info_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/Divider" />

                    <!-- 工号由系统分配，只读 -->
                    <include
                        android:id="@+id/rowDoctorCode"
                        layout="@layout/widget_info_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.WinsRehab.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="联系方式" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WinsRehab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPaddingLeft="@dimen/space_16"
                app:contentPaddingRight="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/layoutPhone"
                        layout="@layout/widget_info_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/Divider" />

                    <include
                        android:id="@+id/layoutEmail"
                        layout="@layout/widget_info_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="点击任意一行即可修改，工号由系统分配不可修改"
                android:textAppearance="@style/TextAppearance.WinsRehab.Body12"
                android:textColor="@color/on_surface_tertiary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
