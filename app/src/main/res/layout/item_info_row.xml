<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:padding="@dimen/space_16"
    android:orientation="horizontal">

    <!-- 左侧图标 -->
    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        tools:src="@drawable/ic_phone"
        app:tint="@color/brand_patient_primary" /> <!-- green-600 -->

    <!-- 左侧标题 -->
    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        tools:text="标题"
        android:textColor="@color/on_surface_secondary" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" /> <!-- text-gray-700 -->

    <!-- 弹簧 View，将右侧内容顶过去 -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <!-- 右侧数值 (可选) -->
    <TextView
        android:id="@+id/rowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_8"
        tools:text="数值"
        android:textColor="@color/on_surface" android:textAppearance="@style/TextAppearance.WinsRehab.Body14" /> <!-- text-gray-900 -->

<!--    &lt;!&ndash; 右箭头 &ndash;&gt;-->
<!--    <ImageView-->
<!--        android:layout_width="20dp"-->
<!--        android:layout_height="20dp"-->
<!--        android:src="@drawable/ic_chevron_right"-->
<!--        app:tint="@color/on_surface_tertiary" /> &lt;!&ndash; text-gray-400 &ndash;&gt;-->
</LinearLayout>