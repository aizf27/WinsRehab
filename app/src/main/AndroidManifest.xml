<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
            android:name=".MyApp"
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.WinsRehab">
        <!--医生登陆页-->
        <activity
            android:name=".ui.main.doctor.login.DtLogActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.WinsRehab.Doctor" />
        <!--患者登陆页-->
        <activity android:name=".ui.main.patient.login.PtLogActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.WinsRehab.Patient" />
        <!--医生主页-->
        <activity android:name=".ui.main.doctor.home.DtHomeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.WinsRehab.Doctor" />
        <!--患者主界面（带底部导航栏）-->
        <activity android:name=".ui.main.patient.main.PtMainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.WinsRehab.Patient" />
        <!--        心理助手界面-->
        <activity android:name=".ui.main.patient.psychology.PsychologyActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.WinsRehab.Patient" />
        <!--视频列表界面-->
        <activity android:name=".ui.main.patient.Video.TrainingVideoActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.WinsRehab.Patient" />
        <!--视频播放界面-->
        <activity android:name=".ui.main.patient.Video.VideoPlayerActivity"
            android:exported="false"
            android:launchMode="standard"
            android:theme="@style/Theme.WinsRehab.Patient" />
        <!--等待医生确认页面-->
        <activity android:name=".ui.main.patient.binding.WaitingBindingActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.WinsRehab.Patient" />
        <!--医生端患者申请列表页面（第 5 组补顶部栏后改挂 Theme.WinsRehab.Doctor）-->
        <activity android:name=".ui.main.doctor.application.PatientApplicationActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.WinsRehab.Doctor.WithBar" />
        <!--创建康复计划页面-->
        <activity android:name=".ui.main.doctor.plan.CreateRehabPlanActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.WinsRehab.Doctor" />
        <!--把SelectLogActivity设为启动Activity -->
        <activity
            android:name=".ui.main.selectLog.SelectLogActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.WinsRehab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
